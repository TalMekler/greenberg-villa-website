# Bootstrap admin account — used ONLY to create the first account, on a run where
# the users table is still empty. After that the database is the source of truth
# and these values are ignored (change the password in /admin instead).
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me

# Supabase Postgres. Dashboard → Project Settings → Database → Connection string.
# Use the "Transaction pooler" URI (port 6543) for the running server.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Supabase Storage, for the site photos.
# Dashboard → Project Settings → API keys. The secret key (older projects call it
# the service_role key) is server-side only — it bypasses row-level security, so
# it must never reach the browser. Either variable name works.
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SECRET_KEY=<secret-key>

# Not used: the publishable key is for browsers, and SUPABASE_JWKS_URL belongs
# to Supabase Auth. This app keeps its own accounts in the users table.
# Optional; defaults to site-images.
# SUPABASE_BUCKET=site-images
