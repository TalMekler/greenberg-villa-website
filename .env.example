# Bootstrap admin account — used ONLY to create the first account, on a run where
# the users table is still empty. After that the database is the source of truth
# and these values are ignored (change the password in /admin instead).
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me

# Supabase Postgres. Dashboard → Project Settings → Database → Connection string.
# Use the "Transaction pooler" URI (port 6543) for the running server.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Supabase Storage, for the site photos.
# Dashboard → Project Settings → API keys. The secret key (older projects call it
# the service_role key) is server-side only — it bypasses row-level security, so
# it must never reach the browser. Either variable name works.
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SECRET_KEY=<secret-key>

# Not used: the publishable key is for browsers, and SUPABASE_JWKS_URL belongs
# to Supabase Auth. This app keeps its own accounts in the users table.
# Optional; defaults to site-images.
# SUPABASE_BUCKET=site-images

# Optional: email the hosts whenever a guest sends a booking inquiry.
# Create a key at https://resend.com/api-keys. Without it inquiries are still
# saved and shown in /admin, just not emailed.
# RESEND_API_KEY=re_...
# Who gets the email, comma-separated. Defaults to every admin account.
# NOTIFY_EMAIL=you@example.com
# Sender. Defaults to Resend's shared onboarding@resend.dev, which only delivers
# to the address your Resend account was opened with. Verify a domain in Resend
# to send from your own address, e.g. "Green Villa <inquiries@yourdomain.com>".
# NOTIFY_FROM=

# Optional: verify the database's TLS certificate. Paste the CA certificate from
# Supabase → Database → SSL Configuration (PEM; literal "\n" line breaks are fine).
# Without it the connection is encrypted but the server is not authenticated.
# DATABASE_CA_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# Extra browser origins allowed to call the API, comma-separated — e.g. a custom
# domain. On Vercel the production domain and the deployment URL are allowed
# automatically; locally, the Vite dev server.
# ALLOWED_ORIGINS=https://greenvilla.example

# Authorises Vercel Cron to call /api/cron/retention, the daily purge of data
# past its retention period (see README → "How long data is kept"). Any long
# random string, e.g. `openssl rand -hex 32`. Set it in Vercel's environment.
# CRON_SECRET=
