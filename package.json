{
  "name": "eviavillabyclaude",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc -b && vite build && npm run build:api",
    "lint": "oxlint",
    "preview": "vite preview",
    "start": "tsx server/index.ts",
    "migrate:supabase": "tsx scripts/migrate-to-supabase.ts",
    "build:api": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=api/_server.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "express": "^5.2.1",
    "leaflet": "^1.9.4",
    "multer": "^2.3.0",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/leaflet": "^1.9.22",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "better-sqlite3": "^13.0.3",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
